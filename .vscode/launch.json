{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Terminal App",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/terminal/pharmacy_rich.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Python: FastAPI Server",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.backend.api.main:app",
        "--reload",
        "--port", "8000",
        "--host", "0.0.0.0"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Python: Blockchain Demo",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/backend/blockchain/notary.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "C++: Engine Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/pharmacy_engine",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build C++ Engine"
    }
  ]
}
