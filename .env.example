# Pharmacy Management System — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ───
APP_NAME=PharmacyPMS
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ─── Server ───
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# ─── Security ───
SECRET_KEY=change-this-to-a-256-bit-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── Database ───
# SQLite (development)
DATABASE_URL=sqlite:///data/pharmacy.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/pharmacy

# ─── Redis (caching) ───
# REDIS_URL=redis://localhost:6379/0

# ─── Blockchain ───
# BLOCKCHAIN_PROVIDER=https://polygon-rpc.com
# BLOCKCHAIN_CHAIN_ID=137
# BLOCKCHAIN_PRIVATE_KEY=your-private-key
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...

# ─── C++ Engine ───
ENGINE_PATH=./build/pharmacy_engine
ENGINE_HOST=localhost
ENGINE_PORT=50051

# ─── Email / Notifications ───
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
